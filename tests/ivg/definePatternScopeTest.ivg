// Regression test: a named pattern must not depend on the drawing state at its definition site.
// Both definitions below are byte-identical bodies under deliberately different ambient fill and pen;
// the two halves must render identically. (An inline `pattern:[...]` does inherit, by design.)
FORMAT IVG-3 requires:IMPD-1
BOUNDS 0,0,64,16

fill red
pen blue width:3
define pattern p [
	bounds 0,0,8,8
	fill white
	rect 0,0,4,8
]

fill blue
pen red width:1
define pattern q [
	bounds 0,0,8,8
	fill white
	rect 0,0,4,8
]

pen none
fill pattern:p
rect 0,0,32,16
fill pattern:q
rect 32,0,32,16
