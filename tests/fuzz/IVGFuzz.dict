# libFuzzer dictionary for IVGFuzz: IVG-2 and IMPD keywords, option names and syntax. tools/runIVGFuzz.sh and .cmd
# pass it with -dict. Keywords come from the lookup tables and option fetches in src/IVG.cpp and src/IMPD.cpp.

# Format headers
"format"
"requires:"
"IVG-1"
"IVG-2"
"IMPD-1"
"ivgfont-1"
"format IVG-2 requires:IMPD-1\x0a"

# IMPD instructions
"_debug"
"call"
"for"
"if"
"include"
"local"
"meta"
"repeat"
"return"
"stop"
"trace"
"else"
"in"
"step"
"while"

# IMPD functions
"abs"
"acos"
"asin"
"atan"
"ceil"
"cos"
"cosh"
"exp"
"floor"
"log"
"log10"
"sin"
"sinh"
"sqrt"
"tan"
"tanh"
"round"
"pi"
"len"
"def"

# IMPD syntax
"$"
"{"
"}"
"["
"]"
"//"
"/*"
"*/"
"\\"
"\""
";"
":"
","
"=="
"!="
"<="
">="
"&&"
"||"
"?"
"~"
"^"

# IVG instructions
"rect"
"pen"
"fill"
"path"
"matrix"
"scale"
"rotate"
"offset"
"shear"
"context"
"wipe"
"options"
"reset"
"ellipse"
"star"
"mask"
"bounds"
"define"
"font"
"text"
"image"

# IVG font definitions
"metrics"
"glyph"
"kern"
"upm:"
"ascent:"
"descent:"
"linegap:"

