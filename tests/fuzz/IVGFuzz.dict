"aa-gamma:"
"align:"
"anchor:"
"at:"
"caps:"
"caret:"
"clip:"
"color:"
"curve-quality:"
"dash:"
"dash-offset:"
"gradient:"
"height:"
"inverted:"
"joints:"
"miter-limit:"
"opacity:"
"outline:"
"pattern:"
"pattern-resolution:"
"relative:"
"resolution:"
"reverse:"
"rotation:"
"rounded:"
"rule:"
"size:"
"stops:"
"stretch:"
"svg:"
"tracking:"
"transform:"
"uses:"
"width:"
"from:"
"to:"

